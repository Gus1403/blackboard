  els.forEach(el=>{ if(!streaming)animate(el); });
  const rs=els.map(e=>e.getBoundingClientRect()); const top=Math.min(...rs.map(r=>r.top))+window.scrollY, bot=Math.max(...rs.map(r=>r.bottom))+window.scrollY;
