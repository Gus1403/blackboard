let range=null;
document.addEventListener('mouseup',e=>{if(pill.contains(e.target))return;setTimeout(()=>{const sel=window.getSelection();if(!sel||sel.isCollapsed||!sel.toString().trim()||MODE==='grid'){pill.style.display='none';return}
