  if(!exp&&blk){ const lab=text.split(/\s+/).slice(0,6).join(' ').toLowerCase(); const hit=notesAfter(blk).find(f=>f.dataset.label===lab); if(hit){ hit.classList.remove('closed'); hit.querySelector('.exp').scrollIntoView({behavior:'smooth',block:'center'}); ask({kind:'fold',id:hit.dataset.for,folded:false}); window.getSelection().removeAllRanges(); pill.style.display='none'; return; } }
  const pending='p'+Date.now();
  const req={kind:'explain',depth:k,text,block:blk?blk.id:'',line:blk?+blk.dataset.line:0,pending};
  if(exp){ const wholeLine=text.length>40&&exp.textContent.trim().startsWith(text.slice(0,30)); if(k==='deep'&&wholeLine)req.grow=exp.dataset.id; else req.parent=exp.dataset.id; }
  // placeholder unfolds immediately
