  const others=wss.filter(w=>w!==mine);
  if(others.length) h+=`<section class="hubsec" data-sec="others"><h2>Other folders on this computer</h2>${others.map(w=>`<div class="course" data-ws="${w.slug}"><h3><a href="/w/${w.slug}/lessons">${esc(w.name)}</a><span class="sub">${w.count} lesson${w.count===1?'':'s'} · last ${w.last}</span></h3><div class="row">${w.lessons.slice().reverse().map(l=>card(l,w,false)).join('')}</div></div>`).join('')}</section>`;
  main.innerHTML=h;
