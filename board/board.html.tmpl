  cards.forEach(c=>c.addEventListener('transitionend',e=>{ if(e.propertyName==='transform'&&e.target===c&&c.classList.contains('flip'))c.classList.add('settled'); }));
  d.onclick=e=>{ const c=e.target.closest('.fc'); if(c&&c===cur()&&(c.classList.contains('graded')||c.classList.contains('peeked'))&&!e.target.closest('button,textarea')){ setFlip(c,!c.classList.contains('flip')); } };
  d.onkeydown=e=>{ if(e.target.matches('textarea'))return; if(e.key==='ArrowRight'&&!next.disabled)next.click(); if(e.key==='ArrowLeft'&&!prev.disabled)prev.click(); };
  d.tabIndex=-1;
  show(i,0);
  cards.forEach(c=>{const ta=c.querySelector('.ans'); if(ta&&ta.value){ta.style.height='auto';ta.style.height=ta.scrollHeight+'px';}});
}
// ---------- more practice panel ----------
function wirePanel(q){
  q.querySelectorAll('.topic').forEach(b=>b.onclick=()=>{q.querySelectorAll('.topic').forEach(o=>o.classList.remove('on'));b.classList.add('on')});
  q.querySelectorAll('.tile').forEach(b=>b.onclick=()=>{q.querySelectorAll('.tile').forEach(o=>o.classList.remove('on'));b.classList.add('on')});
  const g=q.querySelector('.gen'); if(!g)return;
  g.onclick=()=>{
    if(q.classList.contains('busy'))return;
    const on=q.querySelector('.topic.on'); const t=on&&on.dataset.all?'all':(on?on.textContent:'all');
    const m=(q.querySelector('.tile.on')||{}).dataset.mode||'cards';
    const box=q.querySelector('.genbox'); q.classList.add('busy');
    box.innerHTML=(m==='cards'?'<div class="skcard"><div class="sk"><span></span><span></span></div></div>':'<div class="sk"><span></span><span></span><span></span></div>')+`<p class="busylbl">Writing ${m==='cards'?'flashcards':'questions'}</p>`;
    const pending='p'+Date.now();
    ask({kind:'quiz',topic:t,mode:m,count:4,pending}).then(r=>{
      if(r&&r.error){q.classList.remove('busy');box.innerHTML='<p class="busylbl">'+esc(r.error)+'</p>';return}
      poll(pending,st=>{
        q.classList.remove('busy');
        if(st.status==='error'){box.innerHTML='<p class="busylbl">'+esc(st.error||'failed')+'</p>';return}
        box.innerHTML='';
        // the items arrive with the file; land on them once they render
        const ids=st.ids||[]; if(ids.length){ const ds=deckState[lessonId]; if(m==='cards'&&ds){ const deck=main.querySelector('.deck'); const idx=deck?[...deck.querySelectorAll('.fc:not(.summary)')].findIndex(c=>c.dataset.item===ids[0]):-1; if(idx>=0)ds.i=idx; }
          setTimeout(()=>{ const el=m==='cards'?main.querySelector('.deck'):main.querySelector(`.mcqi[data-item="${ids[0]}"]`); if(el)el.scrollIntoView({behavior:'smooth',block:'center'}); },400); }
      });
    });
  };
}
function wire(){
  main.querySelectorAll('.exp').forEach(e=>{e.onclick=ev=>{if(ev.target.closest('a')||window.getSelection().toString().trim())return; if(e.classList.contains('pending'))return; const w=e.closest('.fold'); if(!w)return; ev.stopPropagation(); const closed=!w.classList.contains('closed'); w.classList.toggle('closed',closed); ask({kind:'fold',id:e.dataset.id,folded:closed}); }});
  // a side photo and the block that follows it share a two-column row, so the text never jumps width mid-paragraph
  main.querySelectorAll('.blk > .photo.side').forEach(ph=>{ const b=ph.parentElement; if(b.parentElement.classList.contains('sidepair'))return; const nxt=b.nextElementSibling; if(!nxt||!nxt.classList.contains('blk')||nxt.querySelector('h2,h3,.photo,.figure,.quiz,.deck'))return; const pair=document.createElement('div'); pair.className='sidepair'; b.parentElement.insertBefore(pair,b); pair.appendChild(nxt); pair.appendChild(b); });
  // every note underlines its words in the block above it, even when the words sit inside rendered math
  main.querySelectorAll('.fold[data-label]').forEach(f=>{ const lab=f.dataset.label; if(!lab||f.closest('.exp'))return; const b=blockBefore(f); if(!b)return; if([...b.querySelectorAll('.asked')].some(a=>a.textContent.trim().toLowerCase()===lab))return; markAsked(b,lab); });
  main.querySelectorAll('.asked').forEach(a=>{a.onclick=ev=>{const words=a.textContent.trim().toLowerCase(); const blk=a.closest('.blk'); let w=blk?notesAfter(blk).find(f=>f.dataset.label===words):null; if(!w)w=[...main.querySelectorAll('.fold')].find(f=>f.dataset.label===words); if(!w)return; ev.preventDefault(); ev.stopPropagation(); const open=w.classList.contains('closed'); w.classList.toggle('closed',!open); if(open){w.querySelector('.exp').scrollIntoView({behavior:'smooth',block:'center'})} ask({kind:'fold',id:w.dataset.for,folded:!open}); }});
  main.querySelectorAll('.predict .btn').forEach(b=>{b.onclick=()=>{const pr=b.closest('.predict');if(pr.dataset.done)return;pr.dataset.done=1;
    const key=+(pr.dataset.key??-1), choice=+b.dataset.choice, graded=key>=0, ok=graded&&choice===key;
    if(graded){ b.classList.add(ok?'ok':'no'); if(!ok){const kb=pr.querySelector(`.btn[data-choice="${key}"]`); if(kb)kb.classList.add('key');} }
    else b.classList.add('picked');
    pr.querySelectorAll('.btn').forEach(x=>x.disabled=true);
    pr.querySelector('.reveal').open=true;
    ask({kind:'predict',block:b.closest('.blk').id,choice,correct:graded?ok:null});}});
  main.querySelectorAll('.quiz').forEach(wirePanel);
  main.querySelectorAll('.deck').forEach(wireDeck);
  main.querySelectorAll('.mcqi input').forEach(inp=>{inp.onchange=()=>{const it=inp.closest('.mcqi');if(it.classList.contains('done'))return;it.classList.add('done');const ok=inp.value===it.dataset.key;const lab=inp.closest('label');lab.classList.add(ok?'right':'wrong');it.querySelectorAll('input').forEach(x=>{x.disabled=true;if(x.value===it.dataset.key)x.closest('label').classList.add('right')});it.querySelector('.fb').innerHTML=(ok?'<span class="ok">Correct.</span>':'<span class="bad">Not quite.</span>')+(it.dataset.why?' '+mdInline(it.dataset.why):'');ask({kind:'mcq',item:it.dataset.item,choice:inp.value,correct:ok});}});
}

// ---------- boot ----------
async function boot(){
  state=await fetch('/api/state?x=1'+WSQ+(MODE==='grid'?'&all=1':'')).then(r=>r.json());
  streaming=state.streaming;
  if(MODE==='grid'){grid(state);return}
  if(!lessonId)lessonId=state.current;
  if(!lessonId){main.innerHTML='<p class="empty">No lesson yet. Ask for one in the chat.</p>'}
  else await loadLesson();
  let busy=false;
  async function sync(d){ if(busy)return; busy=true; try{
    if(d){streaming=d.streaming; if(MODE==='lesson'&&!LESSON_ARG&&d.current&&d.current!==lessonId){location.href=WSB+'/';return}}
    const r=await fetch(`/api/lesson?id=${lessonId}&from=${offset}&hash=${hash}${WSQ}`).then(r=>r.json());
    if(r.reset){offset=0;hash='';await loadLessonWith(r);} else if(r.text){await loadLessonWith(r);}
    setWriting(streaming);
  } finally{busy=false} }
  try{ window.es=new EventSource('/events?id='+lessonId+WSQ); window.es.addEventListener('change',e=>sync(JSON.parse(e.data))); }catch(_){}
  // polling fallback (covers webviews where EventSource is flaky)
  setInterval(async()=>{ try{const st=await fetch('/api/state?x=1'+WSQ).then(r=>r.json()); if(state.page_version&&st.page_version!==state.page_version){location.reload();return} if(!(window.es&&window.es.readyState===1)) await sync({current:st.current,streaming:st.streaming});}catch(_){} },1500);
}
async function loadLessonWith(r){
  if(r.reset){const keep=[...main.querySelectorAll('.fold[data-pending]')]; main.innerHTML='';blocks=0;headerDone=false;body='';renderedUpto=0; window.__ph=keep;}
  body+=r.text; offset=r.offset; if(r.hash)hash=r.hash;
  if(!headerDone){const {fm,fmLines}=frontMatter(body); if(/^---\n[\s\S]*?\n---\n/.test(body)||!body.startsWith('---')){main.insertAdjacentHTML('afterbegin',header(fm,null));headerDone=true;document.title=(fm.title?fm.title+' · ':'')+'Blackboard';bodyStart=fmLines;fmCache=fm;applyAccent(fm);setWriting(streaming);} else {setWriting(streaming);return;}}
  const {body:b}=frontMatter(body); const segs=segments(b,bodyStart); const fresh=segs.slice(renderedUpto);
  const raws=segs.map(s=>s.raw); const chg=r.reset?changedRange(lastRaws,raws):null; const hot=[];
  fresh.forEach((s,k)=>{ const idx=renderedUpto+k; if(fmCache.title&&/^# /.test(s.raw)&&idx===0)return; const el=renderSegment(s); main.appendChild(el); if(chg&&idx>=chg[0]&&idx<chg[1])hot.push(el); if(!r.reset||streaming){animate(el);moveNub(el);} if(streaming)followIfAtBottom(el); });
  lastRaws=raws;
  if(hot.length&&!streaming)setTimeout(()=>spotlight(hot),60);
  setWriting(streaming);
  // newly written explanations: unfold with the chalk animation; keep everything else still
  const now=new Set([...main.querySelectorAll('.exp[data-id]')].map(e=>e.dataset.id));
  if(r.reset&&knownExp.size){ now.forEach(id=>{ if(!knownExp.has(id)){ const w=main.querySelector(`.fold[data-for="${id}"]`); if(w){ w.classList.add('closed'); const e=w.querySelector('.exp'); setTimeout(()=>{w.classList.remove('closed');animate(e);},30); } } }); }
  knownExp=now;
  renderedUpto=segs.length; wire(); inlineSvgs();
  // deep link: /lessons/NNNN#e3 opens that note, #b12 scrolls to that block
  if(r.reset&&location.hash){ const h=location.hash.slice(1); const t=main.querySelector(`.exp[data-id="${h}"]`)||document.getElementById(h); if(t){ const f=t.closest('.fold'); if(f)f.classList.remove('closed'); setTimeout(()=>t.scrollIntoView({block:'center'}),80); } }
}
// hash: the server hashes the first N bytes with md5; the client cannot md5 cheaply, so we ask the server for it on every reset
// and keep offset/hash pairs consistent by only ever appending. loadLesson (initial) delegates to loadLessonWith.
loadLesson=async function(){const r=await fetch(`/api/lesson?id=${lessonId}&from=0&hash=${WSQ}`).then(r=>r.json());if(r.missing){main.innerHTML='<p class="empty">No lesson yet. Ask for one in the chat.</p>';return}await loadLessonWith(r);};
boot().catch(e=>{window.bootError=String(e&&e.stack||e);console.error('boot',e)});
</script>
