  if(!total){h+='<p class="empty">Nothing yet. Ask for a lesson in the chat.</p>';main.innerHTML=h;return}
  h+=`<div class="hubbar"><input class="hubq" type="search" placeholder="Search every lesson" autocomplete="off"><div class="chips">${wss.map(w=>`<button class="chip" data-ws="${w.slug}">${esc(w.name)}</button>`).join('')}</div></div>`;
