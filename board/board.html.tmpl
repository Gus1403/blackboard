  q.oninput=apply; main.querySelectorAll('.chip').forEach(b=>{ b.onclick=()=>{ chip=chip===b.dataset.ws?'':b.dataset.ws; main.querySelectorAll('.chip').forEach(x=>x.classList.toggle('on',x.dataset.ws===chip)); apply(); }; });
  q.focus();
}

