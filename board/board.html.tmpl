});
const foldOf=el=>el&&(el.classList.contains('fold')?el:(el.classList.contains('blk')&&el.firstElementChild&&el.firstElementChild.classList.contains('fold')?el.firstElementChild:null));
function notesAfter(blk){ const out=[]; let n=blk.nextElementSibling; while(n){ const f=foldOf(n); if(!f)break; out.push(f); n=n.nextElementSibling; } return out; }
