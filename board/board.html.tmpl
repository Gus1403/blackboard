  ph.innerHTML=`<div class="in"><div class="exp pending${k==='deep'?' deep':''}"><div class="explabel">${esc(label)}</div>writing<span class="nubi"></span></div></div>`;
  const host=exp?exp:(blk||main); if(exp)exp.appendChild(ph); else host.insertAdjacentElement('afterend',ph);
  setTimeout(()=>ph.classList.remove('closed'),30);
  try{ if(!exp&&blk){ const m=document.createElement('span'); m.className='asked'; range.surroundContents(m);} }catch(_){}
  ask(req).then(r=>{ if(r&&r.error){ph.querySelector('.exp').classList.add('error');ph.querySelector('.exp').innerHTML='<div class="explabel">'+esc(label)+'</div>'+esc(r.error)} });
