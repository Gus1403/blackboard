color = 0xe9e6df
B: [ text "Before the loan" big
     T: line from (0,-0.3in) right 2.4in
     line from T.c down 1.1in
     text "owns / is owed" small color 0x8a8a84 at T.start + (0.6in,-0.18in)
     text "owes" small color 0x8a8a84 at T.end + (-0.6in,-0.18in)
     text "Cash" at T.start + (0.3in,-0.5in)
     text "$110" rjust at T.c + (-0.15in,-0.5in)
     text "Deposits" ljust at T.c + (0.15in,-0.5in)
     text "$100" rjust at T.end + (-0.05in,-0.5in)
     text "Owners" ljust at T.c + (0.15in,-0.8in)
     text "$10" rjust at T.end + (-0.05in,-0.8in)
     line from T.start + (0.05in,-1.0in) right 1.05in
     line from T.c + (0.1in,-1.0in) right 1.05in
     text "$110" rjust color 0x8a8a84 at T.c + (-0.15in,-1.2in)
     text "$110" rjust color 0x8a8a84 at T.end + (-0.05in,-1.2in) ]
A: [ text "After the loan" big
     T: line from (0,-0.3in) right 2.4in
     line from T.c down 1.1in
     text "owns / is owed" small color 0x8a8a84 at T.start + (0.6in,-0.18in)
     text "owes" small color 0x8a8a84 at T.end + (-0.6in,-0.18in)
     text "Cash" at T.start + (0.3in,-0.5in)
     text "$110" rjust at T.c + (-0.15in,-0.5in)
     text "Loan" color 0x9b3a4a at T.start + (0.3in,-0.8in)
     text "$80" rjust color 0x9b3a4a at T.c + (-0.15in,-0.8in)
     text "Deposits" ljust color 0x9b3a4a at T.c + (0.15in,-0.5in)
     text "$180" rjust color 0x9b3a4a at T.end + (-0.05in,-0.5in)
     text "Owners" ljust at T.c + (0.15in,-0.8in)
     text "$10" rjust at T.end + (-0.05in,-0.8in)
     line from T.start + (0.05in,-1.0in) right 1.05in
     line from T.c + (0.1in,-1.0in) right 1.05in
     text "$190" rjust color 0x8a8a84 at T.c + (-0.15in,-1.2in)
     text "$190" rjust color 0x8a8a84 at T.end + (-0.05in,-1.2in) ] with .nw at B.ne + (0.9in,0)
arrow from B.e + (0.1in,-0.55in) to A.w + (-0.1in,-0.55in) color 0x9b3a4a "+$80" "both sides" above small
